{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qeva.org/corpus/schemas/candidate.schema.json",
  "title": "QEVA Extracted Candidate 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_version", "id", "work_id", "kind", "text", "locator", "method", "status"],
  "properties": {
    "candidate_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^qeva-candidate:sha256:[0-9a-f]{64}$"},
    "work_id": {"type": "string"},
    "kind": {"enum": ["definition", "claim", "theorem", "conjecture", "proof-reference", "counterexample", "equation", "open-question", "unknown"]},
    "text": {"type": "string", "minLength": 1},
    "locator": {"type": "object"},
    "method": {"type": "string"},
    "status": {"const": "unreviewed-candidate"}
  }
}
