{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qeva.org/corpus/schemas/candidate.schema.json",
  "title": "QEVA Extracted Candidate 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_version",
    "id",
    "work_id",
    "source_assertion_id",
    "raw_sha256",
    "kind",
    "text",
    "locator",
    "method",
    "rights_class",
    "status"
  ],
  "properties": {
    "candidate_version": {"const": "0.2"},
    "id": {
      "type": "string",
      "pattern": "^qeva-candidate:sha256:[0-9a-f]{64}$"
    },
    "work_id": {
      "type": "string",
      "pattern": "^qeva-work:sha256:[0-9a-f]{64}$"
    },
    "source_assertion_id": {
      "type": "string",
      "pattern": "^qeva-source-assertion:sha256:[0-9a-f]{64}$"
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "enum": ["definition", "claim", "theorem", "conjecture", "proof-reference", "counterexample", "equation", "open-question", "unknown"]
    },
    "text": {"type": "string", "minLength": 1},
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalized_jsonl_line", "source", "field", "sentence"],
      "properties": {
        "normalized_jsonl_line": {"type": "integer", "minimum": 1},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "value": {"type": "string", "minLength": 1}
          }
        },
        "field": {"enum": ["title", "abstract"]},
        "sentence": {"type": "integer", "minimum": 0}
      }
    },
    "method": {"type": "string", "minLength": 1},
    "rights_class": {"enum": ["open-license", "public-domain"]},
    "status": {"const": "unreviewed-candidate"}
  }
}
