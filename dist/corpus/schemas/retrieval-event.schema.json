{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qeva.org/corpus/schemas/retrieval-event.schema.json",
  "title": "QEVA Retrieval Event 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_version", "provider", "request_url", "retrieved", "http_status", "media_type", "byte_length", "sha256", "storage_path"],
  "properties": {
    "event_version": {"const": "0.1"},
    "provider": {"type": "string"},
    "request_url": {"type": "string"},
    "retrieved": {"type": "string"},
    "http_status": {"type": "integer"},
    "media_type": {"type": ["string", "null"]},
    "byte_length": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "storage_path": {"type": "string"}
  }
}
