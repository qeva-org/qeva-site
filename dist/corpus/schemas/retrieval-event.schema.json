{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qeva.org/corpus/schemas/retrieval-event.schema.json",
  "title": "QEVA Retrieval Event 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_version",
    "id",
    "provider",
    "request_url",
    "retrieved",
    "http_status",
    "media_type",
    "byte_length",
    "max_response_bytes",
    "sha256",
    "storage_path"
  ],
  "properties": {
    "event_version": {"const": "0.2"},
    "id": {
      "type": "string",
      "pattern": "^qeva-retrieval:sha256:[0-9a-f]{64}$"
    },
    "provider": {"type": "string", "minLength": 1},
    "request_url": {"type": "string", "minLength": 1},
    "retrieved": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
    "media_type": {"type": ["string", "null"]},
    "byte_length": {"type": "integer", "minimum": 0},
    "max_response_bytes": {"type": "integer", "minimum": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "storage_path": {
      "type": "string",
      "pattern": "^raw/[0-9a-f]{64}\\.(?:json|xml|bin)$"
    }
  }
}
