{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qeva.org/corpus/schemas/work.schema.json",
  "title": "QEVA Normalized Work 0.1",
  "type": "object",
  "additionalProperties": true,
  "required": ["corpus_version", "id", "provider", "provider_id", "title", "identifiers", "retrieved", "raw_sha256", "rights"],
  "properties": {
    "corpus_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^qeva-work:sha256:[0-9a-f]{64}$"},
    "provider": {"type": "string", "minLength": 1},
    "provider_id": {"type": ["string", "null"]},
    "title": {"type": ["string", "null"]},
    "authors": {"type": "array", "items": {"type": "string"}},
    "identifiers": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "dates": {"type": "object"},
    "retrieved": {"type": "string"},
    "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rights": {
      "type": "object",
      "required": ["class", "basis", "full_text_mirroring"],
      "properties": {
        "class": {"enum": ["metadata-only", "open-license", "public-domain", "restricted", "unknown"]},
        "basis": {"type": "string"},
        "full_text_mirroring": {"type": "boolean"}
      }
    }
  }
}
