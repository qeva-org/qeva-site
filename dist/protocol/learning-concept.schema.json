{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qeva.org/protocol/learning-concept.schema.json",
  "title": "QEVA learning concept profile 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "concept_ref",
    "title",
    "difficulty",
    "prerequisites",
    "related",
    "explanation",
    "activities",
    "mastery",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "qeva-learning-concept/1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^qeva:learning:[a-z0-9-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "concept_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^qeva:1:[a-z0-9][a-z0-9._-]*@[1-9][0-9]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "difficulty": {
      "enum": [
        "entry",
        "developing",
        "advanced"
      ]
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "minimum_state",
          "reason"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^qeva:learning:[a-z0-9-]+@[1-9][0-9]*$"
          },
          "minimum_state": {
            "enum": [
              "understood",
              "mastered"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        }
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^qeva:1:[a-z0-9][a-z0-9._-]*@[1-9][0-9]*$"
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intuition",
        "manipulation",
        "pattern",
        "mechanism",
        "vocabulary",
        "notation",
        "formal",
        "proof",
        "frontier"
      ],
      "properties": {
        "intuition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "manipulation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "mechanism": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "vocabulary": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "term",
              "meaning"
            ],
            "properties": {
              "term": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "meaning": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              }
            }
          },
          "minItems": 1,
          "maxItems": 100
        },
        "notation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol",
              "meaning"
            ],
            "properties": {
              "symbol": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "meaning": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              }
            }
          },
          "minItems": 1,
          "maxItems": 100
        },
        "formal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_ref",
            "text",
            "context",
            "caveat"
          ],
          "properties": {
            "source_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^qeva:1:[a-z0-9][a-z0-9._-]*@[1-9][0-9]*$"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            "context": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "caveat": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "proof": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "statement",
            "steps",
            "limitation"
          ],
          "properties": {
            "label": {
              "enum": [
                "worked-example",
                "scope-boundary"
              ]
            },
            "statement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "minItems": 0,
              "maxItems": 100
            },
            "limitation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            }
          }
        },
        "frontier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        }
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^qeva:activity:[a-z0-9-]+@[1-9][0-9]*$"
      },
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "mastery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "understood",
        "mastered"
      ],
      "properties": {
        "understood": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^qeva:activity:[a-z0-9-]+@[1-9][0-9]*$"
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "mastered": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^qeva:activity:[a-z0-9-]+@[1-9][0-9]*$"
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_refs",
        "created",
        "license",
        "review_status"
      ],
      "properties": {
        "kind": {
          "const": "editorial-learning-overlay"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^qeva:1:[a-z0-9][a-z0-9._-]*@[1-9][0-9]*$"
          },
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true
        },
        "created": {
          "type": "string",
          "format": "date"
        },
        "license": {
          "const": "CC0-1.0"
        },
        "review_status": {
          "enum": [
            "draft-for-mathematical-review",
            "editorially-reviewed"
          ]
        }
      }
    }
  }
}
