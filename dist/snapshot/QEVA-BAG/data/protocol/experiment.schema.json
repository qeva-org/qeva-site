{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qeva.org/protocol/experiment.schema.json",
  "title": "QEVA Experiment 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_version", "id", "revision", "title", "summary", "family",
    "state_space", "entities", "relations", "operations", "update",
    "parameters", "initial_conditions", "boundary_conditions", "observer",
    "randomness", "run_bounds", "analyzers", "outputs", "executable",
    "related_objects", "provenance", "stewardship", "supersedes"
  ],
  "properties": {
    "experiment_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^qeva-experiment:1:[a-z0-9][a-z0-9._-]*$"},
    "revision": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "family": {"enum": ["projection", "recurrence", "signal", "optimization", "integer-map", "finite-state"]},
    "state_space": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "description", "numeric_domain", "bounds"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "numeric_domain": {"enum": ["integer", "safe-integer", "binary64", "finite-enumeration"]},
        "bounds": {"type": "array"}
      }
    },
    "entities": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "relations": {"type": "array", "items": {"type": "object"}},
    "operations": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "update": {"type": "object"},
    "parameters": {"type": "array", "items": {"type": "object"}},
    "initial_conditions": {"type": "object"},
    "boundary_conditions": {"type": "array", "items": {"type": "string"}},
    "observer": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "kind", "description", "parameters"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "kind": {"enum": ["identity", "remainder", "threshold", "bins", "block-mean", "parity", "objective"]},
        "description": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"}
      }
    },
    "randomness": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "version", "seed_parameter", "deterministic"],
      "properties": {
        "algorithm": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "seed_parameter": {"type": ["string", "null"]},
        "deterministic": {"type": "boolean"}
      }
    },
    "run_bounds": {
      "type": "object", "additionalProperties": false,
      "required": ["steps", "max_states", "max_operations", "timeout_ms"],
      "properties": {
        "steps": {"type": "integer", "minimum": 1},
        "max_states": {"type": "integer", "minimum": 1},
        "max_operations": {"type": "integer", "minimum": 1},
        "timeout_ms": {"type": "integer", "minimum": 1}
      }
    },
    "analyzers": {"type": "array", "items": {"type": "string", "pattern": "^qeva-analyzer:1:[a-z0-9][a-z0-9._-]*@[1-9][0-9]*$"}, "uniqueItems": true},
    "outputs": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "executable": {
      "type": "object", "additionalProperties": false,
      "required": ["engine", "engine_version", "artifact_sha256", "kernel", "kernel_version", "representation", "numeric_semantics"],
      "properties": {
        "engine": {"const": "QEVA Mechanism Engine"},
        "engine_version": {"const": "0.1.0"},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "kernel": {"type": "string", "minLength": 1},
        "kernel_version": {"type": "string", "minLength": 1},
        "representation": {"const": "bounded-declarative-json"},
        "numeric_semantics": {"type": "string", "minLength": 1}
      }
    },
    "related_objects": {"type": "array", "items": {"type": "string", "pattern": "^qeva:1:[a-z0-9][a-z0-9._-]*@[1-9][0-9]*$"}, "uniqueItems": true},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["created", "creator", "license", "parent", "source_refs"],
      "properties": {
        "created": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "creator": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "parent": {"type": ["string", "null"]},
        "source_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "stewardship": {
      "type": "object", "additionalProperties": false,
      "required": ["steward", "visibility", "publication_state"],
      "properties": {
        "steward": {"type": "string", "minLength": 1},
        "visibility": {"enum": ["public", "private", "shared"]},
        "publication_state": {"enum": ["draft", "public", "superseded", "withdrawn"]}
      }
    },
    "supersedes": {"type": ["string", "null"], "pattern": "^qeva-experiment:1:[a-z0-9][a-z0-9._-]*@[1-9][0-9]*$"}
  }
}
