{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qeva.org/protocol/qualification-0.2.schema.json",
  "title": "QEVA Qualification Assertion 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["qualification_version", "id", "revision", "subject", "dimension", "outcome", "method", "artifact", "asserted_by", "asserted", "environment", "supersedes"],
  "properties": {
    "qualification_version": {"const": "0.2"},
    "id": {"type": "string", "pattern": "^qeva-qualification:1:[a-z0-9][a-z0-9._:-]*$"},
    "revision": {"type": "integer", "minimum": 1},
    "subject": {"$ref": "#/$defs/objectRef"},
    "subject_sha256": {"$ref": "#/$defs/sha256"},
    "dimension": {"enum": ["editorial-review", "formal-derivation", "machine-replay", "computational-experiment", "empirical-replication", "refutation"]},
    "outcome": {"enum": ["pass", "fail", "inconclusive", "not-applicable"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "statement_sha256", "claim_relation"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "statement_sha256": {"$ref": "#/$defs/sha256"},
        "claim_relation": {"type": "string", "minLength": 1}
      }
    },
    "method": {"type": "string", "minLength": 1},
    "artifact": {
      "type": ["string", "null"],
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "asserted_by": {"type": "string", "minLength": 1},
    "asserted": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "environment": {"type": "object"},
    "supersedes": {"type": ["string", "null"], "pattern": "^qeva-qualification:1:[a-z0-9][a-z0-9._:-]*@[1-9][0-9]*$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "objectRef": {"type": "string", "pattern": "^qeva:1:[a-z0-9][a-z0-9._-]*@[1-9][0-9]*$"},
    "safeArtifact": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"qualification_version": {"const": "0.2"}}, "required": ["qualification_version"]},
      "then": {"required": ["subject_sha256", "scope"]}
    },
    {
      "if": {
        "properties": {
          "qualification_version": {"const": "0.2"},
          "artifact": {"type": "string"}
        },
        "required": ["qualification_version", "artifact"]
      },
      "then": {"required": ["artifact_sha256"]}
    },
    {
      "if": {
        "properties": {
          "dimension": {"enum": ["formal-derivation", "machine-replay", "refutation"]},
          "outcome": {"enum": ["pass", "fail"]}
        },
        "required": ["dimension", "outcome"]
      },
      "then": {
        "properties": {"artifact": {"$ref": "#/$defs/safeArtifact"}},
        "required": ["artifact"]
      }
    }
  ]
}
