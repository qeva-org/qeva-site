{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qeva.org/protocol/release-envelope.schema.json",
  "title": "QEVA Release Envelope 0.5",
  "type": "object",
  "additionalProperties": false,
  "required": ["release", "released", "title", "protocol", "current_objects", "all_revisions", "qualification_assertions", "history_milestones", "field_nodes", "current_experiments", "analyzers", "typed_relations", "verification", "claims", "legacy"],
  "properties": {
    "release": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "released": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "title": {"type": "string", "minLength": 1},
    "protocol": {"type": "string", "minLength": 1},
    "current_objects": {"type": "integer", "minimum": 0},
    "all_revisions": {"type": "integer", "minimum": 0},
    "qualification_assertions": {"type": "integer", "minimum": 0},
    "history_milestones": {"type": "integer", "minimum": 0},
    "field_nodes": {"type": "integer", "minimum": 0},
    "current_experiments": {"type": "integer", "minimum": 0},
    "analyzers": {"type": "integer", "minimum": 0},
    "typed_relations": {"type": "integer", "minimum": 0},
    "verification": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "claims": {"type": "object", "additionalProperties": {"type": ["boolean", "integer", "string", "null"]}},
    "legacy": {"type": "object"}
  }
}
