{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qeva.org/protocol/qeva-object.schema.json",
  "title": "QEVA Object 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["qeva_version","id","revision","type","title","summary","status","context","assumptions","content","dependencies","relations","verification","provenance"],
  "properties": {
    "qeva_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^qeva:1:[a-z0-9-]+:[a-z0-9-]+$"},
    "revision": {"type": "integer", "minimum": 1},
    "type": {"enum": ["axiom","definition","theorem","conjecture","counterexample","concept","formal-system","inference-rule","algorithm","relation","terminology"]},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "status": {"enum": ["expository","formalized","verified","open","refuted","context-dependent"]},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain","formal_system"],
      "properties": {
        "domain": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "formal_system": {"type": ["string","null"]},
        "scope_note": {"type": ["string","null"]}
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human","exact"],
      "properties": {
        "human": {"type": "string", "minLength": 1},
        "exact": {"type": "string", "minLength": 1},
        "example": {"type": ["string","null"]},
        "caveat": {"type": ["string","null"]}
      }
    },
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind","target"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "note": {"type": ["string","null"]}
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level","method"],
      "properties": {
        "level": {"enum": ["unverified","editorial","formal","machine-checked","refuted"]},
        "method": {"type": "string"},
        "artifact": {"type": ["string","null"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created","creator","license"],
      "properties": {
        "created": {"type": "string", "format": "date"},
        "creator": {"type": "string"},
        "license": {"type": "string"},
        "source_note": {"type": ["string","null"]}
      }
    },
    "revision_of": {"type": ["string","null"]}
  }
}
