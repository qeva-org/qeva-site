{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qeva.org/protocol/qeva-object.schema.json",
  "title": "QEVA Object 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["qeva_version","id","revision","kind","title","summary","domains","context","assumptions","content","dependencies","relations","verification","provenance","supersedes","legacy_ids"],
  "properties": {
    "qeva_version": {"const": "0.2"},
    "id": {"type": "string", "pattern": "^qeva:1:[a-z0-9][a-z0-9._-]*$"},
    "revision": {"type": "integer", "minimum": 1},
    "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "domains": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["framework","framework_ref","note"],
      "properties": {
        "framework": {"type": ["string","null"]},
        "framework_ref": {"type": ["string","null"], "pattern": "^qeva:1:[a-z0-9][a-z0-9._-]*@[1-9][0-9]*$"},
        "note": {"type": ["string","null"]}
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["text","ref"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "ref": {"type": ["string","null"], "pattern": "^qeva:1:[a-z0-9][a-z0-9._-]*@[1-9][0-9]*$"}
        }
      }
    },
    "content": {
      "type": "object", "additionalProperties": false,
      "required": ["plain","exact","example","caveat"],
      "properties": {
        "plain": {"type": "string", "minLength": 1},
        "exact": {"type": "string", "minLength": 1},
        "example": {"type": ["string","null"]},
        "caveat": {"type": ["string","null"]}
      }
    },
    "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^qeva:1:[a-z0-9][a-z0-9._-]*@[1-9][0-9]*$"}, "uniqueItems": true},
    "relations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind","target","note"],
        "properties": {
          "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "target": {"type": "string", "pattern": "^qeva:1:[a-z0-9][a-z0-9._-]*@[1-9][0-9]*$"},
          "note": {"type": ["string","null"]}
        }
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["level","method","artifact"],
      "properties": {
        "level": {"enum": ["unreviewed","editorial","formal-proof","machine-checked","refuted"]},
        "method": {"type": "string", "minLength": 1},
        "artifact": {"type": ["string","null"]}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["created","creator","license","source_note"],
      "properties": {
        "created": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "creator": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "source_note": {"type": ["string","null"]}
      }
    },
    "supersedes": {"type": ["string","null"], "pattern": "^qeva:1:[a-z0-9][a-z0-9._-]*@[1-9][0-9]*$"},
    "legacy_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
