---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found — Qeva" path="/404" noindex>
  <main class="not-found wrap">
    <a class="wordmark" href="/" aria-label="Qeva home">qeva<span class="wordmark-dot">.</span></a>
    <div>
      <p class="eyebrow">404 / Page not found</p>
      <h1>This page isn’t here.</h1>
      <p class="body-copy">The address may have changed. You can head back to Qeva or email Pakin.</p>
      <a class="button" href="/">Back to Qeva <span aria-hidden="true">↗</span></a>
      <a class="quiet-link" href="mailto:hello@qeva.org">hello@qeva.org</a>
    </div>
  </main>
</Layout>
